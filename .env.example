# ---- Database -------------------------------------------------------------
# PostgreSQL 18 is already running on localhost:5432 on this machine.
# Replace YOUR_PASSWORD with the password you set for the `postgres` role.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/interview?schema=public"

# ---- Session signing ------------------------------------------------------
# 32+ random bytes. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="CHANGE_ME_generate_a_long_random_string"

# ---- Interview link tokens ------------------------------------------------
# Public base URL used when generating candidate links.
APP_BASE_URL="http://localhost:3000"

# ---- AI provider ----------------------------------------------------------
# ollama    -> FREE. A model running on this machine. Real judgement, no API
#              key, no per-interview cost, and no candidate data leaves your
#              network. Slower and weaker than a frontier model.
#              Setup:  ollama pull qwen2.5:7b
# mock      -> FREE but cannot judge correctness. Rubric keyword coverage only.
#              Useful for testing the flow, not for hiring decisions.
# anthropic -> PAID (~$0.36/interview on claude-opus-5). Best quality.
AI_PROVIDER="ollama"

# --- ollama ---
OLLAMA_BASE_URL="http://localhost:11434"
# qwen2.5:7b  (~4.7GB) needs ~6GB VRAM or 8GB RAM. Apache-2.0 licensed.
# qwen2.5:3b  (~1.9GB) for weaker machines, noticeably less reliable.
# qwen2.5:14b (~9GB)   if you have the VRAM for it.
OLLAMA_MODEL="qwen2.5:7b"

# --- anthropic (only used when AI_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# ---- Media storage --------------------------------------------------------
# Directory for violation snapshots. Relative paths resolve from the project root.
SNAPSHOT_DIR="./data/snapshots"
# Hard cap on snapshots stored per interview session.
SNAPSHOT_MAX_PER_SESSION="60"

# ---- Seed admin (used by `npm run db:seed`) -------------------------------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ORG_NAME="Example Software House"
